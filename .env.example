APP_NAME=Casino
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casino
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


FRONTEND_ADMIN_URL=http://localhost:3001
FRONTEND_WEB_URL=http://localhost:3000

# PandaScore esports data API (https://developers.pandascore.co). Server-side only.
PANDASCORE_API_TOKEN=
PANDASCORE_BASE_URL=https://api.pandascore.co

# Reverb websocket server (php artisan reverb:start) for GraphQL subscriptions.
# Generate the app id/key/secret with: php artisan reverb:install. 8080 is often taken on Windows (IIS), so use 6001.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=6001
REVERB_SERVER_PORT=6001
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*

# GraphQL subscriptions are pushed through Reverb. Broadcast inline so no queue worker is needed in dev.
LIGHTHOUSE_BROADCASTER=reverb
LIGHTHOUSE_QUEUE_BROADCASTS=false
# Forget a subscription after an hour; clients re-subscribe before then. Without this, closed tabs pile up
# and every update is pushed to each of them.
LIGHTHOUSE_SUBSCRIPTION_STORAGE_TTL=3600
